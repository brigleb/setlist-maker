{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hindsight",
  "version": "0.1.0",
  "identifier": "com.brigleb.hindsight",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Music",
    "copyright": "© 2026 Raymond Brigleb. GPL-3.0-or-later.",
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "14.0" },
    "fileAssociations": [
      { "ext": ["mp3"], "name": "MP3 audio", "role": "Viewer", "mimeType": "audio/mpeg" },
      { "ext": ["m4a"], "name": "MPEG-4 audio", "role": "Viewer", "mimeType": "audio/mp4" },
      { "ext": ["wav"], "name": "WAV audio", "role": "Viewer", "mimeType": "audio/wav" },
      { "ext": ["flac"], "name": "FLAC audio", "role": "Viewer", "mimeType": "audio/flac" }
    ]
  }
}
